# Copy this file to .env and fill in real values. Never commit .env.

# --- AI provider (Phase 1 uses Groq) ---
GROQ_API_KEY=

# --- Database ---
EDGEFORGE_DB_PATH=edgeforge.db

# --- Execution / paper trading (optional, Phase 2+) ---
# Generic webhook your own trading bot listens on, e.g. your Render-hosted
# Flask bot's ingestion endpoint. EdgeForge will POST JSON signal payloads here.
EDGEFORGE_WEBHOOK_URL=

# --- Flask ---
PORT=5000
FLASK_DEBUG=0
